+/**
+ * ScenarioLocking — behavioral tests (T-HEP-004 Gap 2)
+ *
+ * Closes the logic gap in `ScenarioLocking.dom.test.tsx` which audits the
+ * static shape (no document.write, uses DOM API) but not the actual
+ * click → window.open → DOM tree → callback chain.
+ *
+ * Spec: docs/drafts/hephaestus/logic-gap-test-spec.md §2
+ * ADR: ADR-011 (plugin sandbox AST — adjacent; ScenarioLocking is the print/lock UI)
+ * Source: src/components/ui/ScenarioLocking.tsx:99-110
+ *
+ * Cases: 7
+ * Est: ~1.5 hr
+ */
+
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { render, screen, fireEvent, cleanup } from '@testing-library/react';
+import { ScenarioLocking } from '../../../src/components/ui/ScenarioLocking';
+import type { ScenarioMetrics } from '../../../src/types';
+
+const stubMetrics: ScenarioMetrics = {
+  revenue: 1_000_000,
+  expenses: 750_000,
+  netIncome: 250_000,
+  cashFlow: 180_000,
+  runway: 18,
+  burnRate: 55_000,
+  headcount: 12,
+  customerCount: 45,
+  arrGrowth: 0.12,
+};
+
+describe('ScenarioLocking — behavioral (ADR-011)', () => {
+  beforeEach(() => cleanup());
+
+  // Helper: build a mock window with a DOM we can introspect
+  function buildMockPrintWindow() {
+    const elements: { tag: string; text?: string }[] = [];
+    const mockDoc = {
+      createElement: vi.fn((tag: string) => {
+        const el = { tagName: tag.toUpperCase(), textContent: '' };
+        elements.push(el as unknown as { tag: string; text?: string });
+        return el;
+      }),
+      body: { appendChild: vi.fn() },
+      title: '',
+      close: vi.fn(),
+    };
+    return {
+      elements,
+      doc: mockDoc,
+      window: {
+        document: mockDoc,
+        focus: vi.fn(),
+        close: vi.fn(),
+      },
+    };
+  }
+
+  // 1. Clicking the lock button opens a new window with _blank target
+  it('clicking lock button calls window.open with _blank target', () => {
+    const mock = buildMockPrintWindow();
+    const openSpy = vi.spyOn(window, 'open').mockReturnValue(mock.window as unknown as Window);
+
+    render(
+      <ScenarioLocking
+        scenarioId="s-1"
+        scenarioName="Q3 Plan"
+        isLocked={false}
+        onLockToggle={vi.fn()}
+        metrics={stubMetrics}
+      />
+    );
+    fireEvent.click(screen.getByRole('button', { name: /lock|unlock|edit/i }));
+
+    expect(openSpy).toHaveBeenCalledTimes(1);
+    const args = openSpy.mock.calls[0];
+    expect(args?.[1]).toBe('_blank');
+  });
+
+  // 2. The opened window's document is built via createElement (not document.write)
+  it('the opened window uses createElement (NOT document.write) to build the print DOM', () => {
+    const mock = buildMockPrintWindow();
+    const writeSpy = vi.spyOn(mock.doc as unknown as { write: () => void }, 'write').mockImplementation(() => {});
+    vi.spyOn(window, 'open').mockReturnValue(mock.window as unknown as Window);
+
+    render(
+      <ScenarioLocking
+        scenarioId="s-2"
+        scenarioName="Q4 Forecast"
+        isLocked={false}
+        onLockToggle={vi.fn()}
+        metrics={stubMetrics}
+      />
+    );
+    fireEvent.click(screen.getByRole('button', { name: /lock|unlock|edit/i }));
+
+    expect(writeSpy).not.toHaveBeenCalled();
+    expect(mock.doc.createElement).toHaveBeenCalled();
+  });
+
+  // 3. onLockToggle is called with (scenarioId, true) when the lock button is clicked
+  it('onLockToggle is called with (scenarioId, true) on lock click', () => {
+    vi.spyOn(window, 'open').mockReturnValue(buildMockPrintWindow().window as unknown as Window);
+    const onLockToggle = vi.fn();
+
+    render(
+      <ScenarioLocking
+        scenarioId="s-3"
+        scenarioName="H1 Actual"
+        isLocked={false}
+        onLockToggle={onLockToggle}
+        metrics={stubMetrics}
+      />
+    );
+    fireEvent.click(screen.getByRole('button', { name: /lock|unlock|edit/i }));
+
+    expect(onLockToggle).toHaveBeenCalledWith('s-3', true);
+  });
+
+  // 4. onLockToggle is called with (scenarioId, false) when re-clicking a locked scenario
+  it('onLockToggle is called with (scenarioId, false) when re-clicking a locked scenario', () => {
+    vi.spyOn(window, 'open').mockReturnValue(buildMockPrintWindow().window as unknown as Window);
+    const onLockToggle = vi.fn();
+
+    render(
+      <ScenarioLocking
+        scenarioId="s-4"
+        scenarioName="H2 Plan"
+        isLocked={true}
+        onLockToggle={onLockToggle}
+        metrics={stubMetrics}
+      />
+    );
+    fireEvent.click(screen.getByRole('button', { name: /lock|unlock|edit/i }));
+
+    expect(onLockToggle).toHaveBeenCalledWith('s-4', false);
+  });
+
+  // 5. The print window contains the scenario name in its body
+  it('the print window DOM contains the scenario name as text', () => {
+    const mock = buildMockPrintWindow();
+    vi.spyOn(window, 'open').mockReturnValue(mock.window as unknown as Window);
+
+    render(
+      <ScenarioLocking
+        scenarioId="s-5"
+        scenarioName="Q3 — & Q4 Plan <draft>"
+        isLocked={false}
+        onLockToggle={vi.fn()}
+        metrics={stubMetrics}
+      />
+    );
+    fireEvent.click(screen.getByRole('button', { name: /lock|unlock|edit/i }));
+
+    // The component should have created at least one element with the scenario name
+    const nameEl = mock.elements.find((e) => e.text?.includes('Q3 — & Q4 Plan <draft>'));
+    expect(nameEl).toBeDefined();
+  });
+
+  // 6. XSS payload in scenario name is rendered as TEXT, not as a live script
+  it('XSS payload in scenario name is rendered as text, not as a script element', () => {
+    const mock = buildMockPrintWindow();
+    vi.spyOn(window, 'open').mockReturnValue(mock.window as unknown as Window);
+
+    const xssName = "<script>window.__pwned = true;</script>";
+    render(
+      <ScenarioLocking
+        scenarioId="s-6"
+        scenarioName={xssName}
+        isLocked={false}
+        onLockToggle={vi.fn()}
+        metrics={stubMetrics}
+      />
+    );
+    fireEvent.click(screen.getByRole('button', { name: /lock|unlock|edit/i }));
+
+    // None of the created elements should be a SCRIPT tag
+    const scriptEls = mock.elements.filter((e) => e.tag === 'script');
+    expect(scriptEls).toHaveLength(0);
+    // The text should be present (as text), but the script should not have executed
+    expect((window as unknown as { __pwned?: boolean }).__pwned).toBeUndefined();
+  });
+
+  // 7. The metric numbers (revenue, expenses) appear in the print window
+  it('the print window DOM includes the metric values (revenue, expenses, etc.)', () => {
+    const mock = buildMockPrintWindow();
+    vi.spyOn(window, 'open').mockReturnValue(mock.window as unknown as Window);
+
+    render(
+      <ScenarioLocking
+        scenarioId="s-7"
+        scenarioName="Annual"
+        isLocked={false}
+        onLockToggle={vi.fn()}
+        metrics={stubMetrics}
+      />
+    );
+    fireEvent.click(screen.getByRole('button', { name: /lock|unlock|edit/i }));
+
+    // The component should have created at least one element with the revenue
+    const revenueEl = mock.elements.find((e) => e.text?.includes('1,000,000') || e.text?.includes('1000000'));
+    expect(revenueEl).toBeDefined();
+  });
+});
