+/**
+ * PluginSandbox.execute — runtime behavior tests (T-HEP-004 Gap 1)
+ *
+ * Closes the logic gap in `PluginSandbox.acorn.test.ts` which covers the
+ * static AST allowlist (`validatePluginCode`) but not the runtime execute
+ * path (`executeSandboxed`).
+ *
+ * Spec: docs/drafts/hephaestus/logic-gap-test-spec.md §1
+ * ADR: ADR-011 (plugin sandbox AST)
+ * Source: src/plugins/PluginSandbox.ts:194 `executeSandboxed`, L133 `SandboxOptions`, L140 `SandboxResult`
+ *
+ * Cases: 8
+ * Est: ~1.5 hr
+ */
+
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { executeSandboxed, validatePluginCode } from '../../../src/plugins/PluginSandbox';
+import type { PluginAPI } from '../../../src/plugins/types';
+
+const mockApi: PluginAPI = {
+  formula: { registerFunction: vi.fn(), listFunctions: () => [] },
+  dashboards: { registerWidget: vi.fn() },
+  export: { toCSV: vi.fn(), toExcel: vi.fn() },
+  import: { fromCSV: vi.fn() },
+} as unknown as PluginAPI;
+
+describe('PluginSandbox.execute — runtime behavior (ADR-011)', () => {
+  beforeEach(() => vi.clearAllMocks());
+
+  // 1. PluginAPI is callable from inside the sandbox
+  it('user code can call api.formula.registerFunction and the registration persists', () => {
+    const code = `
+      finplan.formula.registerFunction('myFn', () => 42);
+    `;
+    const result = executeSandboxed(code, mockApi);
+    expect(result.success).toBe(true);
+    expect(mockApi.formula.registerFunction).toHaveBeenCalledWith('myFn', expect.any(Function));
+  });
+
+  // 2. Return value is wrapped in SandboxResult.success=true
+  it('a script that returns a value wraps it in { success: true, value }', () => {
+    const result = executeSandboxed('return 42;', mockApi);
+    expect(result).toEqual({ success: true, value: 42 });
+  });
+
+  // 3. Runtime exception is wrapped in SandboxResult.success=false
+  it('a script that throws returns { success: false, error } with the message', () => {
+    const result = executeSandboxed("throw new Error('boom');", mockApi);
+    expect(result.success).toBe(false);
+    expect(result.error).toContain('boom');
+  });
+
+  // 4. Async user code is awaited
+  it('async user code is awaited (return await Promise.resolve(7))', async () => {
+    const result = await Promise.resolve(executeSandboxed('return await Promise.resolve(7);', mockApi));
+    expect(result).toEqual({ success: true, value: 7 });
+  });
+
+  // 5. The PluginAPI passed to executeSandboxed is the SAME object the user code sees
+  it('the api object is the SAME reference visible to user code (not a copy)', () => {
+    const captured: { seen: unknown } = { seen: null };
+    // We pre-set a property on the api, then read it from inside the sandbox
+    (mockApi as unknown as { __sentinel: number }).__sentinel = 99;
+    const result = executeSandboxed('return finplan.__sentinel;', mockApi);
+    expect(result).toEqual({ success: true, value: 99 });
+  });
+
+  // 6. Two invocations share the same api but have isolated lexical scope
+  it('two invocations have isolated lexical scope (no `const` leakage)', () => {
+    const a = executeSandboxed('const x = 1; return x;', mockApi);
+    const b = executeSandboxed('return typeof x;', mockApi);
+    expect(a).toEqual({ success: true, value: 1 });
+    // x is NOT a global; from the second invocation's perspective it's undefined
+    expect(b.success).toBe(true);
+  });
+
+  // 7. Timeout: a long-running script is killed when timeout < execution time
+  it('timeout option: an infinite loop is killed when timeout expires', () => {
+    // 10ms timeout — an infinite loop cannot finish in 10ms
+    const result = executeSandboxed('while (true) {}', mockApi, { timeout: 10 });
+    expect(result.success).toBe(false);
+    expect(result.error).toBeDefined();
+  });
+
+  // 8. The pre-validate path (validatePluginCode) gates execute
+  it('a script that fails validatePluginCode is rejected before execute', () => {
+    const evil = "eval('process.exit(1)');";
+    const validation = validatePluginCode(evil);
+    expect(validation.ok).toBe(false);
+    // We do NOT call executeSandboxed here — that would throw a hard error
+    // (the dangerous-pattern check is separate from the AST allowlist).
+  });
+});
