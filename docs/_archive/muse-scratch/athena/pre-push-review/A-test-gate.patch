 // Apollo PRE-PUSH P0 #0 — Athena pre-validation amendment
 // Adds displayName + Symbol + toJSON guards so React DevTools shows
 // the icon name and Proxy invariant violations don't occur on serialization.
 vi.mock('lucide-react', () => {
+  const makeIcon = (name: string) => {
+    const Icon = forwardRef<SVGSVGElement, LucideProps>((props, ref) =>
+      React.createElement('svg', { ...props, ref, 'data-testid': `icon-${name}` })
+    );
+    Icon.displayName = name;
+    return Icon;
+  };
+
   return new Proxy(
     {},
     {
       get(_target, prop) {
-        if (typeof prop === 'string' && /^[A-Z]/.test(prop)) {
-          return forwardRef<SVGSVGElement, LucideProps>((props, ref) =>
-            React.createElement('svg', { ...props, ref, 'data-testid': `icon-${String(prop)}` })
-          );
-        }
-        return undefined;
+        if (prop === 'displayName') return undefined;
+        if (prop === Symbol.toPrimitive || prop === 'toJSON') return undefined;
+        if (typeof prop === 'string' && /^[A-Z]/.test(prop)) return makeIcon(prop);
+        return undefined;
       },
     }
   );
@@ -85,7 +92,6 @@ vi.mock('../workers/worker-pool', () => {
