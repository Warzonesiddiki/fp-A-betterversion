# <!-- DRAFT v0.1 — awaiting review — Atlas 2026-06-13 -->
#
# FinPlan Pro — Tauri Desktop Build Container
# Multi-stage: frontend (Node) → tauri-builder (Rust + Tauri CLI) → signer
# Companion doc: docs/drafts/atlas/DOCKER_TAURI.md
#
# Build:    docker build -t finplan-tauri -f Dockerfile.tauri .
# Use:      docker run --rm -v $PWD/out:/out finplan-tauri build linux-x64
# Dev:      docker run --rm -it -v $PWD:/app -w /app finplan-tauri bash
#
# Pin: ubuntu:24.04 (Noble Numbat) — ships webkit2gtk-4.1 + libsoup-3.0
#       required by Tauri 2. ubuntu:22.04 has only webkit2gtk-4.0 (broken).
#       Three Witnesses: see DOCKER_TAURI.md §1.

# ════════════════════════════════════════════════════════════════════════
# Stage 1 — Frontend (Node 22 + Vite, produces dist/)
# ════════════════════════════════════════════════════════════════════════
FROM node:22.11.0-bookworm-slim AS frontend

WORKDIR /app

# Copy only manifests first to maximize layer cache hit rate
# (~95% of PRs hit the warm npm cache).
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Copy the rest of the source and build
COPY . .
RUN npm run build

# dist/ is the only artifact we need from this stage.
# ~80 MB layer (slim base + node_modules cached via BuildKit).

# ════════════════════════════════════════════════════════════════════════
# Stage 2 — Tauri builder (Rust 1.83 + Tauri CLI + Linux system deps)
# ════════════════════════════════════════════════════════════════════════
FROM mcr.microsoft.com/devcontainers/rust:1.83-bookworm AS tauri-builder

# System deps for Tauri 2 on Linux. Three Witnesses: DOCKER_TAURI.md §3.
# webkit2gtk-4.1 is the Tauri 2 WebView backend.
# libayatana-appindicator3 is required for the system tray (per
# tauri.conf.json:60-66). librsvg2 for icon rendering.
# libssl-dev + libcurl4-openssl-dev are C deps that Tauri's reqwest
# transitively links. osslsigncode is the Linux Authenticode signer.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libwebkit2gtk-4.1-dev \
    libsoup-3.0-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    pkg-config \
    build-essential \
    file \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Tauri CLI (pinned to 2.x; will need bump on Tauri 3)
# Using cargo install for reproducibility; in CI we use --locked
# against the committed Cargo.lock so transitive changes are loud.
RUN cargo install tauri-cli --version "^2.0" --locked

WORKDIR /app

# Copy the prebuilt frontend from Stage 1
COPY --from=frontend /app/dist ./dist

# Copy the Tauri source + Cargo manifests
COPY src-tauri/ ./src-tauri/
COPY package.json ./

# Build the Tauri binary. Output:
#   src-tauri/target/release/bundle/{msi,nsis,dmg,deb,rpm,appimage}/
# SLO: < 240 s warm, < 600 s cold.
RUN cd src-tauri && cargo tauri build --bundles all

# ════════════════════════════════════════════════════════════════════════
# Stage 3 — Signer (Ubuntu minimal + signing tools)
# ════════════════════════════════════════════════════════════════════════
FROM ubuntu:24.04 AS signer

# Install ONLY the signing tools — no Rust, no Node.
# This stage is reusable for any future Tauri project.
RUN apt-get update && apt-get install -y --no-install-recommends \
    # .deb signer
    dpkg-sig \
    # .rpm signer + tools
    rpm \
    # GPG (for .AppImage + TUF manifest)
    gnupg2 \
    # Windows Authenticode (from Linux)
    osslsigncode \
    # File utility (for verifying signed outputs)
    file \
    ca-certificates \
    # Tauri CLI (for `tauri signer sign` of the TUF manifest)
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Tauri CLI here too so we can sign the TUF manifest
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && . "$HOME/.cargo/env" \
    && cargo install tauri-cli --version "^2.0" --locked

WORKDIR /work

# Copy the unsigned bundle artifacts from Stage 2
COPY --from=tauri-builder /app/src-tauri/target/release/bundle/ /work/bundle/

# Default entrypoint — expects the caller to mount a /out volume and
# override with a build target like `linux-x64`.
# Example: docker run --rm -v $PWD/out:/out finplan-tauri build linux-x64
ENTRYPOINT ["/work/scripts/entrypoint.sh"]
CMD ["--help"]

# Image size budget:
#   frontend stage:    ~80 MB  (slim Node + node_modules cache)
#   tauri-builder:   ~3.5 GB  (Rust toolchain + target/)
#   signer:           ~250 MB  (Ubuntu + signing tools)
# Final image: ~250 MB (the signer stage). The tauri-builder stage
# is intermediate; its artifacts live in --mount -v output.
