+  const runMonteCarlo = async () => {
+    setLoading(true);
+    try {
+      const base = actuals?.revenue || 1000000;
+      const baseCosts = base * (variableCostPct / 100) + fixedCost;
+      const request: MonteCarloRequest = {
+        iterations,
+        assumptions: [
+          { name: 'revenue', type: 'uniform', min: base * 0.8, max: base * 1.2 },
+          { name: 'costs',   type: 'uniform', min: baseCosts * 0.85, max: baseCosts * 1.15 },
+        ],
+      };
+      const response = await runMonteCarloWorker(request);
+      // Worker output sums assumption values; recover profit = revenue - costs.
+      const profits = response.results.map((r) => r.values.revenue - r.values.costs).sort((a, b) => a - b);
+      const avgProfit = profits.reduce((s, p) => s + p, 0) / profits.length;
+      const median = profits[Math.floor(profits.length / 2)];
+      const p10 = profits[Math.floor(profits.length * 0.1)];
+      const p90 = profits[Math.floor(profits.length * 0.9)];
+      const positiveOutcomes = profits.filter((p) => p >= 0).length;
