+      throw new Error('baseMetrics must be an object');
+    }
+    if (!Array.isArray(config.drivers)) {
+      throw new Error('drivers must be an array');
+    }
+    if (config.drivers.length === 0) {
+      throw new Error('drivers must not be empty');
+    }
+    if (typeof config.iterations !== 'number' || config.iterations < 1) {
+      throw new Error('iterations must be at least 1');
+    }
+    if (config.iterations > 1_000_000) {
+      throw new Error('iterations cannot exceed 1,000,000');
+    }
+
+    const validMetrics: (keyof ScenarioMetrics)[] = [
+      'revenue',
+      'ebitda',
+      'netIncome',
+      'cashFlow',
+      'headcount',
+      'burnRate',
+      'runway',
+      'grossMargin',
+      'ebitdaMargin',
+    ];
+
+    for (const driver of config.drivers) {
+      if (!driver.name || typeof driver.name !== 'string') {
+        throw new Error('Each driver must have a non-empty name');
+      }
+      MonteCarloEngine.validateDistribution(driver.distribution);
+      if (!validMetrics.includes(driver.targetMetric)) {
+        throw new Error(
+          `targetMetric "${driver.targetMetric}" must be one of: ${validMetrics.join(', ')}`
+        );
+      }
+      if (!['percentage', 'absolute'].includes(driver.impactType)) {
+        throw new Error('impactType must be "percentage" or "absolute"');
+      }
+    }
+
+    // --- Setup PRNG ---
+    const randomFn = config.seed !== undefined ? createPRNG(config.seed) : Math.random;
+
+    // --- Build per-metric value arrays ---
+    const metricValues: Record<keyof ScenarioMetrics, number[]> = {
+      revenue: [],
+      ebitda: [],
+      netIncome: [],
+      cashFlow: [],
+      headcount: [],
+      burnRate: [],
+      runway: [],
+      grossMargin: [],
+      ebitdaMargin: [],
+    };
+
+    for (let i = 0; i < config.iterations; i++) {
+      // Start with base metrics
+      const metrics: ScenarioMetrics = { ...config.baseMetrics };
+
+      // Apply each driver's sampled value
+      for (const driver of config.drivers) {
+        const sample = sampleDistribution(driver.distribution, randomFn);
+        const base = config.baseMetrics[driver.targetMetric];
+
+        if (driver.impactType === 'percentage') {
+          (metrics as unknown as Record<string, number>)[driver.targetMetric] =
+            base * (1 + sample / 100);
+        } else {
+          (metrics as unknown as Record<string, number>)[driver.targetMetric] = base + sample;
+        }
+      }
+
+      // Recalculate derived metrics
+      (metrics as unknown as Record<string, number>).netIncome = metrics.ebitda;
+      (metrics as unknown as Record<string, number>).ebitdaMargin =
+        metrics.revenue !== 0 ? (metrics.ebitda / metrics.revenue) * 100 : 0;
+
+      // Store values
+      for (const key of validMetrics) {
+        metricValues[key]!.push(metrics[key]!);
+      }
+    }
+
+    // --- Compute per-metric statistics ---
+    const metricResults = {} as Record<keyof ScenarioMetrics, MonteCarloResult>;
+    for (const key of validMetrics) {
+      const sorted = [...metricValues[key]].sort((a, b) => a - b);
+      metricResults[key] = MonteCarloEngine.computeStatistics(
+        metricValues[key]!,
+        [],
+        config.iterations,
+        config.confidenceLevel
+      );
+    }
+
+    // --- Compute risk metrics from net income distribution ---
+    const niSorted = [...metricValues.netIncome].sort((a, b) => a - b);
+    const niMean = computeMean(metricValues.netIncome);
+    const niStdDev = computeStdDev(computeVariance(metricValues.netIncome, niMean));
+
+    // Probability of profit
+    const profitCount = metricValues.netIncome.filter((v) => v > 0).length;
+    const probabilityOfProfit = profitCount / config.iterations;
+
+    // Value at Risk (loss at the confidence level)
+    const alpha = 1 - config.confidenceLevel;
+    const varIndex = Math.floor(alpha * niSorted.length);
+    const valueAtRisk = -niSorted![Math.min(varIndex, niSorted.length - 1)]!;
+
+    // Conditional VaR (expected shortfall)
+    const tailValues = niSorted.slice(0, varIndex + 1);
+    const conditionalValueAtRisk = tailValues.length > 0 ? -computeMean(tailValues) : 0;
+
+    return {
+      iterations: config.iterations,
+      metrics: metricResults,
+      netIncome: metricResults.netIncome,
+      probabilityOfProfit,
+      valueAtRisk,
+      conditionalValueAtRisk,
+    };
+  }
+
+  /**
+   * Generate correlation-adjusted samples.
+   * Uses Cholesky decomposition of a correlation matrix.
+   *
+   * @param distributions - Array of distribution configs
+   * @param correlationMatrix - Lower-triangular correlation matrix (must be positive semi-definite)
+   * @param iterations - Number of samples to generate
+   * @param seed - Optional seed for reproducibility
+   * @returns Array of correlated sample records
+   */
+  static generateCorrelatedSamples(
+    distributions: DistributionConfig[],
+    correlationMatrix: number[][],
+    iterations: number,
+    seed?: number
+  ): ReadonlyArray<Record<string, number>> {
+    const n = distributions.length;
+
+    if (correlationMatrix.length !== n) {
+      throw new Error('correlationMatrix rows must match distributions length');
+    }
+    for (const row of correlationMatrix) {
+      if (row.length !== n) {
+        throw new Error('correlationMatrix must be square');
+      }
+    }
+
+    // Cholesky decomposition
+    const L: number[][] = Array.from({ length: n }, () => Array(n).fill(0));
+    for (let i = 0; i < n; i++) {
+      for (let j = 0; j <= i; j++) {
+        let sum = 0;
+        for (let k = 0; k < j; k++) {
+          sum += L![i]![k]! * L![j]![k]!;
+        }
+        if (i === j) {
+          const val = correlationMatrix![i]![i]! - sum;
+          L[i]![j] = val > 0 ? Math.sqrt(val) : 0;
+        } else {
+          L[i]![j] = L[j]![j] !== 0 ? (correlationMatrix![i]![j]! - sum) / L![j]![j]! : 0;
+        }
+      }
+    }
+
+    const randomFn = seed !== undefined ? createPRNG(seed) : Math.random;
+    const results: Record<string, number>[] = [];
+
+    for (let iter = 0; iter < iterations; iter++) {
+      // Generate independent standard normals via Box-Muller
+      const independents: number[] = [];
+      for (let i = 0; i < n; i++) {
+        const u1 = randomFn();
+        const u2 = randomFn();
+        independents.push(Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2));
+      }
+
+      // Apply Cholesky to get correlated normals
+      const correlated: number[] = [];
+      for (let i = 0; i < n; i++) {
+        let sum = 0;
+        for (let j = 0; j <= i; j++) {
+          sum += L![i]![j]! * independents![j]!;
+        }
+        correlated.push(sum);
+      }
+
+      // Transform to target distributions using inverse CDF (percent-point function)
+      const sample: Record<string, number> = {};
+      for (let i = 0; i < n; i++) {
+        const dist = distributions[i]!;
+        const u = 0.5 * (1 + erf(correlated![i]! / Math.sqrt(2))); // normal CDF
+        sample[dist.name] = inverseCDF(dist, u, randomFn);
+      }
+
+      results.push(sample);
+    }
+
+    return results;
+  }
+
+  /**
+   * Create a reusable simulation runner for a given configuration.
+   * Useful for running multiple simulations with the same setup but different seeds.
+   */
+  static createRunner(config: Omit<MonteCarloConfig, 'seed'>): {
+    run: (seed?: number) => MonteCarloResult;
+  } {
+    return {
+      run: (seed?: number) => MonteCarloEngine.simulate({ ...config, seed }),
+    };
+  }
+
+  // ---------------------------------------------------------------------------
+  // Internal helpers
+  // ---------------------------------------------------------------------------
+
+  /** Validate a distribution configuration */
+  static validateDistribution(config: DistributionConfig): void {
+    if (!config.name || typeof config.name !== 'string') {
+      throw new Error('Each distribution must have a non-empty name');
+    }
+    const validTypes: DistributionType[] = [
+      'normal',
+      'uniform',
+      'triangular',
+      'lognormal',
+      'beta',
+      'exponential',
+      'poisson',
+    ];
+    if (!validTypes.includes(config.type)) {
+      throw new Error(
+        `Distribution "${config.name}" type must be one of: ${validTypes.join(', ')}`
+      );
+    }
+
+    switch (config.type) {
+      case 'normal':
+      case 'lognormal':
+        if (config.mean !== undefined && !Number.isFinite(config.mean)) {
+          throw new Error(`Distribution "${config.name}" mean must be finite`);
+        }
+        if (
+          config.stdDev !== undefined &&
+          (typeof config.stdDev !== 'number' || config.stdDev < 0)
+        ) {
+          throw new Error(`Distribution "${config.name}" stdDev must be non-negative`);
+        }
+        break;
+      case 'uniform':
+        if (typeof config.min !== 'number' || typeof config.max !== 'number') {
+          throw new Error(`Distribution "${config.name}" must have min and max`);
+        }
+        if (config.min >= config.max) {
+          throw new Error(`Distribution "${config.name}" min must be less than max`);
+        }
+        break;
+      case 'triangular':
+        if (typeof config.min !== 'number' || typeof config.max !== 'number') {
+          throw new Error(`Distribution "${config.name}" must have min and max`);
+        }
+        if (config.min >= config.max) {
+          throw new Error(`Distribution "${config.name}" min must be less than max`);
+        }
+        break;
+      case 'beta':
+        if (typeof config.alpha !== 'number' || config.alpha <= 0) {
+          throw new Error(`Distribution "${config.name}" alpha must be positive`);
+        }
+        if (typeof config.betaParam !== 'number' || config.betaParam <= 0) {
+          throw new Error(`Distribution "${config.name}" betaParam must be positive`);
+        }
+        break;
+      case 'exponential':
+      case 'poisson':
+        if (typeof config.lambda !== 'number' || config.lambda <= 0) {
+          throw new Error(`Distribution "${config.name}" lambda must be positive`);
+        }
+        break;
+    }
+  }
+
+  /** Compute full statistics from a values array */
+  static computeStatistics(
+    values: number[],
+    rawSamples: Record<string, number>[],
+    iterations: number,
+    confidenceLevel: number
+  ): MonteCarloResult {
+    const sorted = [...values].sort((a, b) => a - b);
+    const mean = computeMean(values);
+    const variance = computeVariance(values, mean);
+    const stdDev = computeStdDev(variance);
+    const median = computeMedian(sorted);
+    const skewness = computeSkewness(values, mean, stdDev);
+    const kurtosis = computeKurtosis(values, mean, stdDev);
+
+    // Percentiles
+    const percentileLevels = [1, 5, 10, 25, 50, 75, 90, 95, 99];
+    const percentiles: Record<number, number> = {};
+    for (const p of percentileLevels) {
+      percentiles[p] = computePercentile(sorted, p);
+    }
+
+    // Confidence interval
+    const alpha = (1 - confidenceLevel) / 2;
+    const lowerPct = alpha * 100;
+    const upperPct = (1 - alpha) * 100;
+    const confidenceInterval: ConfidenceInterval = {
+      lower: computePercentile(sorted, lowerPct),
+      upper: computePercentile(sorted, upperPct),
+      level: confidenceLevel,
+    };
+
+    // Histogram
+    const histogram = computeHistogram(values, 30);
+
+    return {
+      iterations,
+      mean,
+      median,
+      stdDev,
+      variance,
+      min: sorted[0]!,
+      max: sorted[sorted.length - 1]!,
+      skewness,
+      kurtosis,
+      percentiles,
+      confidenceInterval,
+      histogram,
+      values,
+      rawSamples,
+    };
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Error function (erf) approximation for correlated sampling
+// ---------------------------------------------------------------------------
+
+function erf(x: number): number {
+  const sign = x >= 0 ? 1 : -1;
+  const absX = Math.abs(x);
+
+  // Abramowitz and Stegun approximation 7.1.26
+  const a1 = 0.254829592;
+  const a2 = -0.284496736;
+  const a3 = 1.421413741;
+  const a4 = -1.453152027;
+  const a5 = 1.061405429;
+  const p = 0.3275911;
+
+  const t = 1 / (1 + p * absX);
+  const y = 1 - ((((a5 * t + a4) * t + a3) * t + a2) * t + a1) * t * Math.exp(-absX * absX);
+
+  return sign * y;
+}
+
+/** Inverse CDF: transform uniform [0,1] to target distribution */
+function inverseCDF(config: DistributionConfig, u: number, randomFn: () => number): number {
+  switch (config.type) {
+    case 'normal': {
+      // Inverse normal CDF approximation (rational)
+      const z = inverseNormalCDF(u);
+      return (config.mean ?? 0) + z * (config.stdDev ?? 1);
+    }
+    case 'uniform':
+      return (config.min ?? 0) + u * ((config.max ?? 1) - (config.min ?? 0));
+    case 'triangular': {
+      const a = config.min ?? 0;
+      const b = config.max ?? 1;
+      const c = config.mode ?? 0.5;
+      const fc = (c - a) / (b - a);
+      if (u < fc) return a + Math.sqrt(u * (b - a) * (c - a));
+      return b - Math.sqrt((1 - u) * (b - a) * (b - c));
+    }
+    case 'lognormal': {
+      const z = inverseNormalCDF(u);
+      return Math.exp((config.mean ?? 0) + z * (config.stdDev ?? 1));
+    }
+    case 'beta':
+    case 'exponential':
+    case 'poisson':
+      // For these, fall back to direct sampling (inverse CDF is complex)
+      return sampleDistribution(config, randomFn);
+    default:
+      return config.mean ?? 0;
+  }
+}
+
+/** Approximate inverse normal CDF (Beasley-Springer-Moro) */
+function inverseNormalCDF(p: number): number {
+  if (p <= 0) return -Infinity;
+  if (p >= 1) return Infinity;
+  if (p === 0.5) return 0;
+
+  const a = [
+    -3.969683028665376e1, 2.209460984245205e2, -2.759285104469687e2, 1.38357751867269e2,
+    -3.066479806614716e1, 2.506628277459239,
+  ];
+  const b = [
+    -5.447609879822406e1, 1.615858368580409e2, -1.556989798598866e2, 6.680131188771972e1,
+    -1.328068155288572e1,
+  ];
+  const c = [
+    -7.784894002430293e-3, -3.223964580411365e-1, -2.400758277161838, -2.549732539343734,
+    4.374664141464968, 2.938163982698783,
+  ];
+  const d = [7.784695709041462e-3, 3.224671290700398e-1, 2.445134137142996, 3.754408661907416];
+
+  const pLow = 0.02425;
+  const pHigh = 1 - pLow;
+  let q: number;
+  let r: number;
+
+  if (p < pLow) {
+    q = Math.sqrt(-2 * Math.log(p));
+    return (
+      (((((c![0]! * q + c![1]!) * q + c![2]!) * q + c![3]!) * q + c![4]!) * q + c![5]!) /
+      ((((d![0]! * q + d![1]!) * q + d![2]!) * q + d![3]!) * q + 1)
+    );
+  } else if (p <= pHigh) {
+    q = p - 0.5;
+    r = q * q;
+    return (
+      ((((((a![0]! * r + a![1]!) * r + a![2]!) * r + a![3]!) * r + a![4]!) * r + a![5]!) * q) /
+      (((((b![0]! * r + b![1]!) * r + b![2]!) * r + b![3]!) * r + b![4]!) * r + 1)
+    );
+  } else {
+    q = Math.sqrt(-2 * Math.log(1 - p));
+    return (
+      -(((((c![0]! * q + c![1]!) * q + c![2]!) * q + c![3]!) * q + c![4]!) * q + c![5]!) /
+      ((((d![0]! * q + d![1]!) * q + d![2]!) * q + d![3]!) * q + 1)
+    );
+  }
+}
