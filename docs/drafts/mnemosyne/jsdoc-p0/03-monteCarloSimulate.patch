+// =============================================================================
+// MONTE CARLO SIMULATION ENGINE — Full-featured probabilistic analysis
+// Integrates with ScenarioEngine for financial scenario generation
+// Pure TypeScript, deterministic with seeded PRNG, testable
+// =============================================================================
+
+import type { ScenarioMetrics } from '@/types';
+import { ScenarioEngine } from './ScenarioEngine';
+import type { Distribution, ScenarioDriver } from './ScenarioEngine';
+
+// ---------------------------------------------------------------------------
+// Types
+// ---------------------------------------------------------------------------
+
+export type DistributionType =
+  | 'normal'
+  | 'uniform'
+  | 'triangular'
+  | 'lognormal'
+  | 'beta'
+  | 'exponential'
+  | 'poisson';
+
+export interface DistributionConfig {
+  readonly name: string;
+  readonly type: DistributionType;
+  /** Normal / Lognormal: mean of the distribution (or underlying normal for lognormal) */
+  readonly mean?: number;
+  /** Normal / Lognormal: standard deviation */
+  readonly stdDev?: number;
+  /** Uniform / Triangular: lower bound */
+  readonly min?: number;
+  /** Uniform / Triangular: upper bound */
+  readonly max?: number;
+  /** Triangular: mode (most likely value) */
+  readonly mode?: number;
+  /** Beta: alpha shape parameter */
+  readonly alpha?: number;
+  /** Beta: beta shape parameter */
+  readonly betaParam?: number;
+  /** Exponential / Poisson: rate parameter */
+  readonly lambda?: number;
+}
+
+export interface MonteCarloConfig {
+  /** Number of simulation iterations */
+  readonly iterations: number;
+  /** Confidence level for intervals (e.g. 0.95 for 95%) */
+  readonly confidenceLevel: number;
+  /** Distribution assumptions for each variable */
+  readonly assumptions: DistributionConfig[];
+  /** Model function: takes sampled values, returns a single output */
+  readonly model: (samples: Record<string, number>) => number;
+  /** Optional seed for reproducible PRNG */
+  readonly seed?: number;
+}
+
+export interface ConfidenceInterval {
+  readonly lower: number;
+  readonly upper: number;
+  readonly level: number;
+}
+
+export interface HistogramBin {
+  readonly lower: number;
+  readonly upper: number;
+  readonly count: number;
+  readonly density: number;
+}
+
+export interface MonteCarloResult {
+  readonly iterations: number;
+  readonly mean: number;
+  readonly median: number;
+  readonly stdDev: number;
+  readonly variance: number;
+  readonly min: number;
+  readonly max: number;
+  readonly skewness: number;
+  readonly kurtosis: number;
+  readonly percentiles: Record<number, number>;
+  readonly confidenceInterval: ConfidenceInterval;
+  readonly histogram: HistogramBin[];
+  readonly values: readonly number[];
+  readonly rawSamples: ReadonlyArray<Record<string, number>>;
+}
+
+export interface MonteCarloDriver {
+  readonly name: string;
+  readonly distribution: DistributionConfig;
+  /** Which ScenarioMetric this driver affects */
+  readonly targetMetric: keyof ScenarioMetrics;
+  /** Whether the distribution value is a percentage change or absolute value */
+  readonly impactType: 'percentage' | 'absolute';
+}
+
+export interface ScenarioMonteCarloConfig {
+  /** Base financial metrics to simulate around */
+  readonly baseMetrics: ScenarioMetrics;
+  /** Drivers that define how variables affect the base metrics */
+  readonly drivers: MonteCarloDriver[];
+  /** Number of simulation iterations */
+  readonly iterations: number;
+  /** Confidence level for intervals */
+  readonly confidenceLevel: number;
+  /** Optional seed for reproducibility */
+  readonly seed?: number;
+}
+
+export interface ScenarioMonteCarloResult {
+  readonly iterations: number;
+  /** Per-metric simulation results */
+  readonly metrics: Record<keyof ScenarioMetrics, MonteCarloResult>;
+  /** Overall net income distribution */
+  readonly netIncome: MonteCarloResult;
+  /** Probability of profit (net income > 0) */
+  readonly probabilityOfProfit: number;
+  /** Value at Risk at the given confidence level */
+  readonly valueAtRisk: number;
+  /** Conditional Value at Risk (expected shortfall) */
+  readonly conditionalValueAtRisk: number;
+}
+
+// ---------------------------------------------------------------------------
+// Seeded PRNG (Mulberry32)
+// ---------------------------------------------------------------------------
+
+function createPRNG(seed: number): () => number {
+  let state = seed | 0;
+  return () => {
+    state = (state + 0x6d2b79f5) | 0;
+    let t = Math.imul(state ^ (state >>> 15), 1 | state);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Distribution Sampling
+// ---------------------------------------------------------------------------
+
+function sampleDistribution(config: DistributionConfig, randomFn: () => number): number {
+  switch (config.type) {
+    case 'normal': {
+      // Box-Muller transform
+      const u1 = randomFn();
+      const u2 = randomFn();
+      const z0 = Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);
+      return (config.mean ?? 0) + z0 * (config.stdDev ?? 1);
+    }
+    case 'uniform': {
+      const min = config.min ?? 0;
+      const max = config.max ?? 1;
+      return min + randomFn() * (max - min);
+    }
+    case 'triangular': {
+      const a = config.min ?? 0;
+      const b = config.max ?? 1;
+      const c = config.mode ?? 0.5;
+      const fc = (c - a) / (b - a);
+      const r = randomFn();
+      if (r < fc) return a + Math.sqrt(r * (b - a) * (c - a));
+      return b - Math.sqrt((1 - r) * (b - a) * (b - c));
+    }
+    case 'lognormal': {
+      // Sample from underlying normal, exponentiate
+      const mu = config.mean ?? 0;
+      const sigma = config.stdDev ?? 1;
+      const u1 = randomFn();
+      const u2 = randomFn();
+      const z0 = Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);
+      return Math.exp(mu + z0 * sigma);
+    }
+    case 'beta': {
+      // Johnk's algorithm using gamma variates
+      const a = config.alpha ?? 2;
+      const b = config.betaParam ?? 5;
+      const ga = sampleGamma(a, randomFn);
+      const gb = sampleGamma(b, randomFn);
+      return ga / (ga + gb);
+    }
+    case 'exponential': {
+      const lambda = config.lambda ?? 1;
+      const u = randomFn();
+      return -Math.log(1 - u) / lambda;
+    }
+    case 'poisson': {
+      // Knuth's algorithm
+      const lambda = config.lambda ?? 1;
+      const limit = Math.exp(-lambda);
+      let k = 0;
+      let p = 1;
+      do {
+        k++;
+        p *= randomFn();
+      } while (p > limit);
+      return k - 1;
+    }
+    default:
+      return config.mean ?? 0;
+  }
+}
+
+/** Sample from Gamma(shape, 1) using Marsaglia and Tsang's method */
+function sampleGamma(shape: number, randomFn: () => number): number {
+  if (shape < 1) {
+    // For shape < 1, use the relation: Gamma(a) = Gamma(a+1) * U^(1/a)
+    return sampleGamma(shape + 1, randomFn) * Math.pow(randomFn(), 1 / shape);
+  }
+
+  const d = shape - 1 / 3;
+  const c = 1 / Math.sqrt(9 * d);
+
+  while (true) {
+    let x: number;
+    let v: number;
+    do {
+      // Box-Muller for normal variate
+      const u1 = randomFn();
+      const u2 = randomFn();
+      x = Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2);
+      v = 1 + c * x;
+    } while (v <= 0);
+
+    v = v * v * v;
+    const u = randomFn();
+
+    if (u < 1 - 0.0331 * x * x * x * x) return d * v;
+    if (Math.log(u) < 0.5 * x * x + d * (1 - v + Math.log(v))) return d * v;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Statistical Utilities
+// ---------------------------------------------------------------------------
+
+function computeMean(values: readonly number[]): number {
+  if (values.length === 0) return 0;
+  let sum = 0;
+  for (const v of values) sum += v;
+  return sum / values.length;
+}
+
+function computeVariance(values: readonly number[], mean: number): number {
+  if (values.length < 2) return 0;
+  let sumSq = 0;
+  for (const v of values) {
+    const diff = v - mean;
+    sumSq += diff * diff;
+  }
+  return sumSq / (values.length - 1);
+}
+
+function computeStdDev(variance: number): number {
+  return Math.sqrt(variance);
+}
+
+function computeMedian(sorted: readonly number[]): number {
+  const n = sorted.length;
+  if (n === 0) return 0;
+  if (n % 2 === 1) return sorted[(n - 1) / 2]!;
+  const a = sorted[n / 2 - 1]!;
+  const b = sorted[n / 2]!;
+  return (a + b) / 2;
+}
+
+function computePercentile(sorted: readonly number[], p: number): number {
+  if (sorted.length === 0) return 0;
+  if (p <= 0) return sorted[0]!;
+  if (p >= 100) return sorted[sorted.length - 1]!;
+  const index = (p / 100) * (sorted.length - 1);
+  const lower = Math.floor(index);
+  const upper = Math.ceil(index);
+  if (lower === upper) return sorted[lower]!;
+  const fraction = index - lower;
+  const lowerVal = sorted[lower]!;
+  const upperVal = sorted[upper]!;
+  return lowerVal * (1 - fraction) + upperVal * fraction;
+}
+
+function computeSkewness(values: readonly number[], mean: number, stdDev: number): number {
+  if (values.length < 3 || stdDev === 0) return 0;
+  let sumCubed = 0;
+  for (const v of values) {
+    sumCubed += Math.pow((v - mean) / stdDev, 3);
+  }
+  return sumCubed / values.length;
+}
+
+function computeKurtosis(values: readonly number[], mean: number, stdDev: number): number {
+  if (values.length < 4 || stdDev === 0) return 0;
+  let sumFourth = 0;
+  for (const v of values) {
+    sumFourth += Math.pow((v - mean) / stdDev, 4);
+  }
+  return sumFourth / values.length - 3; // excess kurtosis
+}
+
+function computeHistogram(values: readonly number[], bins: number = 30): HistogramBin[] {
+  if (values.length === 0) return [];
+
+  const min = Math.min(...values);
+  const max = Math.max(...values);
+  if (min === max) {
+    return [{ lower: min, upper: max, count: values.length, density: 1 }];
+  }
+
+  const binWidth = (max - min) / bins;
+  const histogram: HistogramBin[] = [];
+
+  for (let i = 0; i < bins; i++) {
+    const lower = min + i * binWidth;
+    const upper = min + (i + 1) * binWidth;
+    const count = values.filter((v) =>
+      i === bins - 1 ? v >= lower && v <= upper : v >= lower && v < upper
+    ).length;
+    histogram.push({
+      lower,
+      upper,
+      count,
+      density: count / (values.length * binWidth),
+    });
+  }
+
+  return histogram;
+}
