+/**
+ * @file src/plugins/PluginSandbox.acorn.test.ts
+ * @description Integration test for the AST-based plugin sandbox that
+ *              replaces the `new Function(...)` denylist at PluginSandbox.ts:198.
+ *              Verifies the 4-constraint gate (node-type + property + NewExpression
+ *              + identifier) per ADR-007.
+ *
+              @author Hephaestus (aionrs/MiniMax-M3), 2026-06-12
+ * @see docs/drafts/hephaestus/ADR-007-plugin-sandbox-ast.md
+ * @see Apollo task 019ebce7-… P0 #2
+ */
+
+import { describe, it, expect } from 'vitest';
+import { parsePluginSource, validatePluginAst, runPluginInSandbox } from './PluginSandbox';
+
+describe('PluginSandbox — AST gate (ADR-007)', () => {
+  describe('happy path: valid plugin code passes', () => {
+    it('accepts pure arithmetic and string ops', () => {
+      const src = `return cube.get('revenue') * 1.1;`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).not.toThrow();
+    });
+
+    it('accepts map / filter / reduce on registered API objects', () => {
+      const src = `
+        return scenario.rows
+          .filter(r => r.amount > 0)
+          .map(r => r.amount)
+          .reduce((s, a) => s + a, 0);
+      `;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).not.toThrow();
+    });
+
+    it('accepts registered plugin API identifiers (cube, scenario, util, log)', () => {
+      const src = `log.info(cube.get('revenue').toString()); return 0;`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).not.toThrow();
+    });
+  });
+
+  describe('attack 1: prototype chain via ObjectExpression', () => {
+    it("rejects ({})['constructor']['constructor']('return globalThis')()", () => {
+      const src = `return ({})['constructor']['constructor']('return globalThis')();`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).toThrow(/constructor/);
+    });
+  });
+
+  describe('attack 2: prototype chain via ArrayExpression', () => {
+    it("rejects []['constructor']['constructor']('return globalThis')()", () => {
+      const src = `return [].constructor.constructor('return globalThis')();`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).toThrow(/constructor/);
+    });
+  });
+
+  describe('attack 3: bare Function identifier', () => {
+    it("rejects Function('return globalThis')()", () => {
+      const src = `return Function('return globalThis')();`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).toThrow(/identifier.*not in allowlist|Function/);
+    });
+  });
+
+  describe('attack 4: bare eval identifier', () => {
+    it("rejects eval('process.exit(1)')", () => {
+      const src = `eval('process.exit(1)'); return 0;`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).toThrow(/identifier.*not in allowlist|eval/);
+    });
+  });
+
+  describe('attack 5: dynamic import()', () => {
+    it("rejects import('fs')", () => {
+      const src = `import('fs').then(fs => fs.readFile('/etc/passwd')); return 0;`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).toThrow(/Import|import/);
+    });
+  });
+
+  describe('attack 6: globals (globalThis / window / self / this)', () => {
+    it('rejects globalThis.process.exit(1)', () => {
+      const src = `globalThis.process.exit(1); return 0;`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).toThrow(/globalThis/);
+    });
+
+    it('rejects window.process.exit(1)', () => {
+      const src = `window.process.exit(1); return 0;`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).toThrow(/window/);
+    });
+
+    it('rejects this.process.exit(1)', () => {
+      const src = `this.process.exit(1); return 0;`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).toThrow(/this/);
+    });
+  });
+
+  describe('attack 7: string escape bypasses', () => {
+    it('rejects \\x65val', () => {
+      const src = `\\x65val('process.exit(1)'); return 0;`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).toThrow();
+    });
+
+    it('rejects \\u0065val', () => {
+      const src = `\\u0065val('process.exit(1)'); return 0;`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).toThrow();
+    });
+  });
+
+  describe('attack 8: NewExpression (covers new Function, new Proxy, etc.)', () => {
+    it('rejects new Function(...)', () => {
+      const src = `return new Function('return globalThis')();`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).toThrow(/NewExpression|new/);
+    });
+
+    it('rejects new Proxy(target, handler)', () => {
+      const src = `return new Proxy({}, { get: (t, k) => k });`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).toThrow(/NewExpression|new/);
+    });
+  });
+
+  describe('attack 9: forbidden property names', () => {
+    it('rejects .prototype access', () => {
+      const src = `return Math.prototype.toString.call(1);`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).toThrow(/prototype/);
+    });
+
+    it('rejects .__proto__ access', () => {
+      const src = `return ({}).__proto__;`;
+      const ast = parsePluginSource(src);
+      expect(() => validatePluginAst(ast)).toThrow(/__proto__/);
+    });
+  });
+
+  describe('end-to-end sandbox execution', () => {
+    it('runs a valid plugin and returns the expected value', () => {
+      const src = `return cube.get('revenue', '2026-Q3') * 1.1;`;
+      const result = runPluginInSandbox(src, {
+        cube: { get: (k, p) => (k === 'revenue' ? 1000 : 0) },
+      });
+      expect(result).toBe(1100);
+    });
+
+    it('throws when AST validation fails (no execution)', () => {
+      const src = `return Function('return globalThis')();`;
+      expect(() => runPluginInSandbox(src, {})).toThrow();
+    });
+  });
+});
