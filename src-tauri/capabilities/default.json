{
  "$schema": "../gen/schemas/desktop-capability.json",
  "identifier": "default",
  "description": "Default capabilities for the FinPlan Pro application",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "dialog:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-query",
    "updater:default"
  ]
}
