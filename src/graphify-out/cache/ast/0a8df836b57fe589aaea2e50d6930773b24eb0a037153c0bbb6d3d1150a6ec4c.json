ahir\\Desktop\\frontend that i want\\src\\pages\\consolidation\\ConsolidationDashboard.tsx", "source_location": "L332"}, {"caller_nid": "consolidation_consolidationdashboard_consolidationdashboard", "callee": "map", "is_member_call": true, "source_file": "C:\\Users\\Tahir\\Desktop\\frontend that i want\\src\\pages\\consolidation\\ConsolidationDashboard.tsx", "source_location": "L355"}, {"caller_nid": "consolidation_consolidationdashboard_consolidationdashboard", "callee": "(() => {\n                          // Derive per-entity totals from consolidated data\n                          const entityTotals = new Map<\n                            string,\n                            { revenue: number; expenses: number }\n                          >();\n                          for (const e of entities) {\n                            const ed = consolidatedData.worksheet?.combinedEntries || [];\n                            const entityEntries = ed.filter(\n                              (entry: { entityId?: string }) => entry.entityId === e.id\n                            );\n                            const revenue = entityEntries\n                              .filter((entry: { accountCode?: string }) =>\n                                (entry.accountCode || '').startsWith('4')\n                              )\n                              .reduce(\n                                (\n                                  s: number,\n                                  entry: { amount?: number; debit?: number; credit?: number }\n                                ) =>\n                                  s +\n                                  Math.abs(\n                                    entry.amount ?? (entry.debit || 0) - (entry.credit || 0)\n                                  ),\n                                0\n                              );\n                            const expenses = entityEntries\n                              .filter(\n                                (entry: { accountCode?: string }) =>\n                                  (entry.accountCode || '').startsWith('5') ||\n                                  (entry.accountCode || '').startsWith('6')\n                              )\n                              .reduce(\n                                (\n                                  s: number,\n                                  entry: { amount?: number; debit?: number; credit?: number }\n                                ) =>\n                                  s +\n                                  Math.abs(\n                                    entry.amount ?? (entry.debit || 0) - (entry.credit || 0)\n                                  ),\n                                0\n                              );\n                            entityTotals.set(e.id, { revenue, expenses });\n                          }\n                          const totalRevenue = Array.from(entityTotals.values()).reduce(\n                            (s, t) => s + t.revenue,\n                            0\n                          );\n                          const totalExpenses = Array.from(entityTotals.values()).reduce(\n                            (s, t) => s + t.expenses,\n                            0\n                          );\n                          const eliminations =\n                            consolidatedData.worksheet?.eliminations?.reduce(\n                              (s: number, el: { eliminatedAmount?: number }) =>\n                                s + (el.eliminatedAmount || 0),\n                              0\n                            ) || 0;\n                          return (\n                            <>\n                              <tr className=\"hover:bg-[var(--bg-muted)]\" role=\"row\">\n                                <td className=\"py-3 px-4\" role=\"gridcell\">\n                                  Revenue\n                                </td>\n                                {entities.map((e) => (\n                                  <td key={e.id} className=\"py-3 px-4 text-right\" role=\"gridcell\">\n                                    ${(entityTotals.get(e.id)?.revenue || 0).toLocaleString()}\n                                  </td>\n                                ))}\n                                <td className=\"py-3 px-4 text-right text-red-400\" role=\"gridcell\">\n                                  -${eliminations.toLocaleString()}\n                                </td>\n                                <td className=\"py-3 px-4 text-right font-bold\" role=\"gridcell\">\n                                  ${totalRevenue.toLocaleString()}\n                                </td>\n                              </tr>\n                              <tr className=\"hover:bg-[var(--bg-muted)]\" role=\"row\">\n                                <td className=\"py-3 px-4\" role=\"gridcell\">\n                                  Operating Expenses\n                                </td>\n                                {entities.map((e) => (\n                                  <td key={e.id} className=\"py-3 px-4 text-right\" role=\"gridcell\">\n                                    (${(entityTotals.get(e.id)?.expenses || 0).toLocaleString()})\n                                  </td>\n                                ))}\n                                <td className=\"py-3 px-4 text-right\" role=\"gridcell\">\n                                  $0\n                                </td>\n                                <td className=\"py-3 px-4 text-right font-bold\" role=\"gridcell\">\n                                  (${totalExpenses.toLocaleString()})\n                                </td>\n                              </tr>\n                              <tr className=\"bg-[var(--bg-muted)] font-bold\" role=\"row\">\n                                <td className=\"py-3 px-4\" role=\"gridcell\">\n                                  Net Income\n                                </td>\n                                {entities.map((e) => {\n                                  const t = entityTotals.get(e.id);\n                                  const ni = (t?.revenue || 0) - (t?.expenses || 0);\n                                  return (\n                                    <td\n                                      key={e.id}\n                                      className=\"py-3 px-4 text-right text-green-400\"\n                                      role=\"gridcell\"\n                                    >\n                                      ${ni.toLocaleString()}\n                                    </td>\n                                  );\n                                })}\n                                <td className=\"py-3 px-4 text-right\" role=\"gridcell\">\n                                  $0\n                                </td>\n                                <td className=\"py-3 px-4 text-right text-blue-400\" role=\"gridcell\">\n                                  ${(totalRevenue - totalExpenses).toLocaleString()}\n                                </td>\n                              </tr>\n                            </>\n                          );\n                        })", "is_member_call": false, "source_file": "C:\\Users\\Tahir\\Desktop\\frontend that i want\\src\\pages\\consolidation\\ConsolidationDashboard.tsx", "source_location": "L378"}, {"caller_nid": "consolidation_consolidationdashboard_consolidationdashboard", "callee": "map", "is_member_call": true, "source_file": "C:\\Users\\Tahir\\Desktop\\frontend that i want\\src\\pages\\consolidation\\ConsolidationDashboard.tsx", "source_location": "L573"}, {"caller_nid": "consolidation_consolidationdashboard_consolidationdashboard", "callee": "map", "is_member_call": true, "source_file": "C:\\Users\\Tahir\\Desktop\\frontend that i want\\src\\pages\\consolidation\\ConsolidationDashboard.tsx", "source_location": "L605"}, {"caller_nid": "consolidation_consolidationdashboard_consolidationdashboard", "callee": "filter", "is_member_call": true, "source_file": "C:\\Users\\Tahir\\Desktop\\frontend that i want\\src\\pages\\consolidation\\ConsolidationDashboard.tsx", "source_location": "L605"}]}