# =============================================================================
# FinPlan Pro Server — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit your real .env file to version control.
#
# To generate a strong JWT secret, run:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================

# REQUIRED — JWT signing secret (minimum 32 characters, 128+ recommended).
# The server will REFUSE TO START in production if this is unset.
JWT_SECRET=

# Server port (default: 3001)
PORT=3001

# CORS origin for the Vite dev server (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Node environment: development | production | test
NODE_ENV=development
