{
  "name": "finplan-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/eslint/bin/eslint.js src --max-warnings 0 && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "tauri:dev": "node node_modules/@tauri-apps/cli/cli.js dev",
    "tauri:build": "node node_modules/@tauri-apps/cli/cli.js build",
    "lint": "node node_modules/eslint/bin/eslint.js src --fix",
    "format": "node node_modules/prettier/bin/prettier.js --write \"src/**/*.{ts,tsx,css,md}\"",
    "test": "node --max-old-space-size=8192 node_modules/vitest/vitest.mjs run",
    "test:sharded": "node scripts/test-sharded.mjs",
    "test:watch": "node --max-old-space-size=8192 node_modules/vitest/vitest.mjs",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:bench": "node --max-old-space-size=8192 node_modules/vitest/vitest.mjs run --config vitest.bench.config.ts",
    "test:bench:ci": "node --max-old-space-size=8192 node_modules/vitest/vitest.mjs run --reporter=json --outputFile=./bench-results.json --config vitest.bench.config.ts",
    "bundle-check": "node scripts/bundle-check.js",
    "prepare": "husky",
    "repo:hygiene": "node scripts/repo-hygiene-check.mjs",
    "capability:inventory": "node scripts/generate-capability-truth-matrix.mjs",
    "test:a11y": "node node_modules/vitest/vitest.mjs run __tests__/a11y .a11y.test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "money:adoption": "node scripts/money-adoption.mjs",
    "tracker:update": "node scripts/update-tracker.mjs",
    "mock-data:audit": "node scripts/mock-data-audit.mjs",
    "type-safety:ratchet": "node scripts/type-safety-ratchet.mjs",
    "docs:verify": "node scripts/verify-readme-stats.mjs && node scripts/persistence-map-check.mjs && node scripts/schema-equality-check.mjs",
    "engines:manifest": "node scripts/generate-engine-manifest.mjs",
    "engines:verify": "node scripts/generate-engine-manifest.mjs --check",
    "export:verify": "node scripts/export-verify.mjs",
    "license:check": "node scripts/license-check.mjs",
    "sbom": "node scripts/sbom.mjs",
    "architecture:guardrails": "node scripts/architecture-guardrails.mjs",
    "financial:oracles": "node --max-old-space-size=8192 node_modules/vitest/vitest.mjs run src/engines/__tests__/financialStatementOracles.test.ts",
    "compliance:evidence": "node scripts/compliance-evidence.mjs",
    "release:dry-run": "node scripts/release-dry-run.mjs",
    "docs:links": "node scripts/docs-link-check.mjs --strict",
    "money:ast": "node scripts/money-ast-detector.mjs",
    "money:ast:list": "node scripts/money-ast-detector.mjs --list",
    "fabrication:audit": "node scripts/fabrication-detector.mjs",
    "fabrication:list": "node scripts/fabrication-detector.mjs --list",
    "persistence:map": "node scripts/persistence-map-check.mjs",
    "schema:equality": "node scripts/schema-equality-check.mjs",
    "routemap:check": "node scripts/generate-route-map.js --check",
    "escape:ledger": "node scripts/escape-ledger-check.mjs"
  },
