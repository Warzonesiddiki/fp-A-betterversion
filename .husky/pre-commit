#!/bin/sh
# FinPlan Pro — pre-commit quality gates (rewritten per F-0024).
# Real checks only. Ceremonial gates (persona counting, SHA astrology,
# markdown keyword ledgers) were removed — they validated process theater,
# not product correctness. Heavy checks (full suite, build) live in pre-push.
set -e

echo "pre-commit: running staged-file quality gates"

STAGED_TS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' || true)
STAGED_CODE=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx)$' || true)
STAGED_FMT=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx|json|md|css)$' || true)

# Gate 1: ESLint on staged code files (zero warnings).
if [ -n "$STAGED_CODE" ]; then
  echo "→ eslint (staged)"
  echo "$STAGED_CODE" | xargs -n 25 npx eslint --max-warnings 0
else
  echo "→ eslint: no staged code files, skipped"
fi

# Gate 2: TypeScript project check when any TS/TSX is staged.
if [ -n "$STAGED_TS" ]; then
  echo "→ tsc --noEmit (project)"
  npx tsc --noEmit -p tsconfig.json
else
  echo "→ tsc: no staged TS files, skipped"
fi

# Gate 3: Prettier on staged files.
if [ -n "$STAGED_FMT" ]; then
  echo "→ prettier --check (staged)"
  echo "$STAGED_FMT" | xargs -n 30 npx prettier --check
else
  echo "→ prettier: no staged formattable files, skipped"
fi

# Gate 4: staged-diff secret scan (lightweight; CI runs the full gate).
# Scans ADDED lines only: a diff that REMOVES secret material is a
# remediation and must never be blocked by its own deletion lines.
# (Root-cause fix: the whole-diff version made the F-0014 key-removal
# commit itself un-committable.)
echo "→ secret scan (staged diff)"
ADDED_LINES=$(git diff --cached --unified=0 | grep -E '^\+' | grep -v '^\+\+\+' || true)
if printf '%s\n' "$ADDED_LINES" | grep -nE '(BEGIN (RSA|OPENSSH|EC|PRIVATE)|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|sk-[A-Za-z0-9]{32,}|xox[baprs]-[A-Za-z0-9-]{10,})'; then
  echo "✗ Secret-like material detected in staged additions. Commit blocked."
  exit 1
fi
# Known-bad literals must never RE-enter the tree.
if printf '%s\n' "$ADDED_LINES" | grep -nF "$(printf 'finplan-master-storage-%s' 'key-change-in-production')" >/dev/null; then
  echo "✗ Retired hardcoded storage key detected in staged additions. Commit blocked."
  exit 1
fi

echo "✓ pre-commit gates passed"
