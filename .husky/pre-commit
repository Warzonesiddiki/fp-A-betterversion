#!/bin/sh
# <!-- SHIPPED v0.2 — Hephaestus 2026-06-18 — Husky Pre-Commit Hook (CYCLE 25 T-2.5) -->
# =============================================================================
# FinPlan Pro — pre-commit hook (NEW, CYCLE 25 T-3.5 + FIXED T-2.5)
# Created per Hephaestus T-3.5 task (post-TURN 198+ LOCKOUT LIFTED).
# Fixed per FOUNDER PATH A ACK TURN 340+: PC-1/PC-2/PC-4 empty-arg-list bug.
# Purpose: Lighter-weight checks that run BEFORE commit (faster feedback).
# Complements pre-push gates (run BEFORE push, heavier).
# =============================================================================
# Gate Numbering Convention (PRE-COMMIT gates use "PC-" prefix to avoid
# collision with pre-push Gates 1-17):
#   - PC-1: LINT-STAGED (eslint on staged files, lighter than Gate 2)
#   - PC-2: PRETTIER-CHECK (format check on staged files)
#   - PC-3: NEVER-AGAIN RULE #55/#74 GHOST-SHA CHECK (commit-time critical)
#   - PC-4: TSC-ON-STAGED (TypeScript check on staged files only)
# =============================================================================
# FIX T-2.5 (2026-06-18) — Apollo 60th HL TURN 326+ Husky Gate PC-1 BUG
# Bug: When no .ts/.tsx/.js/.jsx files are staged (e.g. docs-only commit),
#      `npx eslint --max-warnings 0 $(... | grep ... | tr '\n' ' ')` receives
#      an EMPTY arg list and ESLint falls back to linting ENTIRE src/,
#      producing 4901 errors + 104 warnings that BLOCK the commit.
# Fix: Wrap each gate in a `FILES=$(...) ; [ -z "$FILES" ] && echo "skip" || run`
#      pattern per Apollo 60th HL suggestion. Skip cleanly when no files match
#      the file-type filter.
# D-007 Honest Labels:
# 1. Original PC-1/PC-2/PC-4 all had the same bug. All 3 fixed in v0.2.
# 2. PC-3 (GHOST-SHA check) has no file-list dependency, so unaffected.
# 3. This fix DOES NOT alter pre-push gates — per NEVER-AGAIN RULE #47.
# =============================================================================

. "$(dirname -- "$0")/_/husky.sh"

echo "Running pre-commit checks (240s ceiling per gate, v0.2 with empty-arg-list fix)..."

# Gate PC-1 — LINT-STAGED (mirrors Gate 10 pre-push but on staged files)
# FIX v0.2: Skip cleanly when no TS/JS files staged (avoids ESLint full-src fallback).
FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx)$' | tr '\n' ' ')
if [ -z "$(echo $FILES | tr -d '[:space:]')" ]; then
  echo "⏭️  PC-1: No TS/JS files staged, skipping LINT-STAGED"
else
  timeout 240 npx eslint --max-warnings 0 $FILES || { echo "❌ Lint-staged failed (or timed out at 240s). Commit blocked."; exit 1; }
fi

# Gate PC-2 — PRETTIER-CHECK (format check on staged files)
# FIX v0.2: Same empty-arg-list fix as PC-1.
FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx|json|md|css)$' | tr '\n' ' ')
if [ -z "$(echo $FILES | tr -d '[:space:]')" ]; then
  echo "⏭️  PC-2: No prettier-supported files staged, skipping PRETTIER-CHECK"
else
  timeout 240 npx prettier --check $FILES || { echo "❌ Prettier check failed (or timed out at 240s). Commit blocked."; exit 1; }
fi

# Gate PC-3 — NEVER-AGAIN RULE #55 / RULE #74 GHOST-SHA CHECK (commit-time critical)
# Catches phantom SHA claims BEFORE they hit git history.
# Scans staged commit message + staged diff for SHA-shaped strings.
# FIX v0.2: No file-list dependency, no change needed.
timeout 240 sh -c '
  STAGED_SHA_COUNT=$(git diff --cached | grep -oE "[0-9a-f]{7,40}" | sort -u | wc -l)
  if [ "$STAGED_SHA_COUNT" -gt 0 ]; then
    echo "⚠️  Found $STAGED_SHA_COUNT SHA-shaped strings in staged diff — verify each per D-002 3-witness (cat-file-t + Read + git log)"
  fi
  exit 0
' || { echo "❌ GHOST-SHA check failed (or timed out at 240s). Commit blocked."; exit 1; }

# Gate PC-4 — TSC-ON-STAGED (TypeScript check on staged files only)
# Lighter than pre-push Gate 1 (full TSC). Uses --noEmit.
# FIX v0.2: Same empty-arg-list fix as PC-1.
FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' | tr '\n' ' ')
if [ -z "$(echo $FILES | tr -d '[:space:]')" ]; then
  echo "⏭️  PC-4: No TS/TSX files staged, skipping TSC-ON-STAGED"
else
  timeout 240 npx tsc --noEmit $FILES || { echo "❌ TSC-staged failed (or timed out at 240s). Commit blocked."; exit 1; }
fi

echo "✅ All pre-commit checks passed (v0.2 with empty-arg-list fix)."
exit 0